# Copy to .env.local and fill in. Never put real secrets in this file.
#
# The publishable key is safe in the browser: it grants nothing on its own,
# because every table is protected by row level security. The service role key
# is the opposite — it bypasses RLS entirely, so it belongs only in server-side
# secrets and must never appear in a NEXT_PUBLIC_ variable or in this repo.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The canonical origin of this deployment. Every emailed link — confirmation,
# magic link, password reset — is built from this, never from a request header.
# No trailing slash. In production this is the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
