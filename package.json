{
  "name": "estia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "client:bundle": "node scripts/client-bundle.mjs",
    "security:check": "node .github/scripts/check-secrets.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run security:check && npm run build",
    "db:proofs": "node scripts/run-db-proofs.mjs",
    "reality": "node scripts/product-reality.mjs",
    "ownership": "node scripts/ownership.mjs",
    "gate": "npm run ownership && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run security:check && npm run client:bundle && npm run reality"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
